{
  "name": "@kongyo2/dwh",
  "version": "0.3.1",
  "description": "Deliver files from a coding agent to a human over a Discord webhook. Files only — no messages, and rate limits are waited out, never surfaced.",
  "keywords": [
    "agent",
    "ai",
    "artifacts",
    "claude-code",
    "cli",
    "coding-agents",
    "discord",
    "file-transfer",
    "webhook"
  ],
  "license": "MIT",
  "author": "kongyo2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongyo2/dwh.git"
  },
  "bin": {
    "dwh": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --pretty false",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint --deny-warnings --format agent",
    "lint:fix": "oxlint --fix --deny-warnings --format agent",
    "lint:pretty": "oxlint --deny-warnings",
    "lint:pretty:fix": "oxlint --fix --deny-warnings",
    "lint:types": "oxlint --type-aware --type-check --deny-warnings --format agent",
    "test": "vitest run",
    "check": "npm run typecheck && npm run typecheck:test && npm run lint && npm run format && npm test",
    "check:package": "attw --pack . --profile esm-only && publint --strict",
    "verify": "npm run check && npm run lint:types && npm run build && npm run check:package",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.19.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
